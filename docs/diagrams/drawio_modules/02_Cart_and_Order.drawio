        <mxCell id="co_note" value="&lt;b&gt;CHECKOUT TRANSLATION&lt;/b&gt;&lt;br/&gt;When a customer checks out, ephemeral cart lines are converted into permanent order lines. Product name, size, and price are copied onto order_items so subsequent catalog changes do not affect completed orders." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#854D0E;fontSize=11;align=left;spacing=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="530" width="900" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>