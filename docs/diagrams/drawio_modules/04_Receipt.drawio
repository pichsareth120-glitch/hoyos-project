        <mxCell id="rec_note" value="&lt;b&gt;IMMUTABLE RECEIPT DESIGN&lt;/b&gt;&lt;br/&gt;Receipts do not query live product tables. All customer and price data is frozen on orders and order_items. This guarantees receipts never change even if products are renamed, re-priced, or deleted later." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#854D0E;fontSize=11;align=left;spacing=10;fontFamily=Helvetica;" vertex="1" parent="1">
